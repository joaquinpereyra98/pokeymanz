<section class="items-list">
    {{#each effects as |section sid|}}
    <div class="accordion-container">
        <div class="item items-header item-grid">
            <i class="{{section.icon}}"></i>
            <div class="item-name">
                <span>{{section.label}}</span>
            </div>
            <div class="item-data">{{localize "POKEYMANZ.Effect.Source"}}</div>
            <div class="item-data">
                {{#if (ne section.type "passive")}}
                {{localize "EFFECT.TabDuration"}}
                {{/if}}
            </div>
            <div class="item-controls">
                <a class="item-control" data-action="createDoc" data-document-class="ActiveEffect"
                    data-type="{{section.type}}" data-tooltip="{{localize 'DOCUMENT.New' type=" Effect" }}">
                    <i class="fas fa-plus"></i>
                </a>
            </div>
        </div>
        <section class="item-list" data-category="{{sid}}">
            {{#each section.effects}}
            <div class="item" data-doc-id="{{doc.id}}" data-document-class="ActiveEffect"  data-effect-type="{{section.type}}">
                <div class="item-header item-grid draggable">
                    <i class="accordion-icon fa-solid fa-caret-down"></i>
                    <div class="item-name">
                        <img class="item-image" src="{{doc.img}}" height="24" width="24" alt="{{doc.name}}" />
                        <span>{{doc.name}}</span>
                    </div>

                    <div class="item-data">{{doc.sourceName}}</div>
                    <div class="item-data">
                        {{#if doc.isTemporary }}
                        {{doc.duration.label}}
                        {{/if}}
                    </div>

                    <div class="item-controls flexrow">
                        {{#if @root.editable}}
                        <a class="item-control" data-action="toggleEffect" {{#if doc.disabled}}
                            data-tooltip="{{localize 'POKEYMANZ.Effect.InactiveEffect' effect=doc.name}}" {{else}}
                            data-tooltip="{{localize 'POKEYMANZ.Effect.ActiveEffect' effect=doc.name}}" {{/if}}>
                            <i class="fas fa-lightbulb{{ifThen doc.disabled '' '-on' }}"></i>
                        </a>
                        {{/if}}
                        <a class="item-control" data-action="viewDoc" data-tooltip="{{localize 'DOCUMENT.Update' type=doc.name }}">
                            <i class="fas fa-edit"></i>
                        </a>
                        {{#if @root.editable}}
                        <a class="item-control" data-action="deleteDoc" data-tooltip="{{localize 'DOCUMENT.Delete' type=doc.name }}">
                            <i class="fas fa-trash"></i>
                        </a>
                        {{/if}}
                    </div>
                </div>
                <div class="item-description">
                    {{{description}}}
                </div>
            </div>
            {{/each}}
        </section>
    </div>
    {{/each}}
</section>