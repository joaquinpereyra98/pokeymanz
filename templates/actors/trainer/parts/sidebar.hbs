<div class="sidebar-card card">
    <div class="portrait actor-portrait">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action={{ifThen
            isPlayMode "renderIP" "editImage" }} alt="{{actor.name}}" title="{{actor.name}}" />
    </div>
    <div class="stat-bar flex justify-around">
        <div class="toughness-container stat-container flex items-center" data-tooltip="Toughness">
            <i class="stat-icon fa-solid fa-shield"></i>
            <input class="stat-input" type="number" name="system.stats.toughness.value"
                value="{{system.stats.toughness.value}}" {{disabled isPlayMode }}>
        </div>
        <div class="wounds-container stat-container flex items-center" data-tooltip="Wounds">
            <i class="stat-icon fa-solid fa-heart"></i>
            <div class="wound-input-container flex">
                <input class="stat-input" type="number" name="system.stats.wounds.value"
                    value="{{system.stats.wounds.value}}">
                <span>/</span>
                <input class="stat-input" type="number" name="system.stats.wounds.max"
                    value="{{system.stats.wounds.max}}" {{disabled isPlayMode }}>
            </div>
        </div>
    </div>
    <div class="stat-bar flex justify-around">
        <div class="advancement-container stat-container flex items-center" data-tooltip="Advancement">
            <i class="stat-icon fa-solid fa-ranking-star"></i>
            <input class="stat-input" type="number" name="system.progress.advancement"
                value="{{system.progress.advancement}}">
        </div>
        <div class="experience-container stat-container flex items-center" data-tooltip="Experience">
            <i class="stat-icon fa-solid fa-circle-star"></i>
            <input class="stat-input" type="number" name="system.progress.experience"
                value="{{system.progress.experience}}">
        </div>
    </div>
    {{#if isPlayMode}}
    {{#if (or pokemonType.primary.value pokemonType.secondary.value)}}
    <div class="types-container flex">
        {{#if pokemonType.primary.value}}
        <div class="type-badge flex items-center size--medium" style="--type-color: {{pokemonType.primary.color}}">
            <img src="{{pokemonType.primary.img}}" alt="{{pokemonType.primary.id}}">
            <span>{{localize pokemonType.primary.name}}</span>
        </div>
        {{/if}}
        {{#if pokemonType.secondary.value}}
        <div class="type-badge flex items-center size--medium" style="--type-color: {{pokemonType.secondary.color}}">
            <img src="{{pokemonType.secondary.img}}" alt="{{pokemonType.secondary.id}}">
            <span>{{localize pokemonType.secondary.name}}</span>
        </div>
        {{/if}}
    </div>
    {{/if}}
    {{else}}
    <div class="types-container flex">
        <div class="type-select-container">
            {{formInput pokemonType.primary.field
            value=pokemonType.primary.value
            localize=true}}
        </div>
        <div class="type-select-container">
            {{formInput pokemonType.secondary.field
            value=pokemonType.secondary.value
            localize=true}}
        </div>
    </div>
    {{/if}}

    {{> "systems/pokeymanz/templates/actors/partials/attributes-container.hbs" }}

</div>