<section class="tab summary {{tab.cssClass}}" data-group="primary" data-tab="summary">
    <div class="flex">

        {{> "systems/pokeymanz/templates/actors/pokemon/parts/sidebar.hbs"}}

        <div class="body-container flex flex-col">
            <input class="document-name" name="name" type="text" value="{{actor.name}}" data-tooltip="{{actor.name}}"
                {{disabled isPlayMode }} />
            <div class="details-container">
                {{#each detailsFields}}
                <div class="input-group" data-tooltip="{{value}}">
                    <label class="input-group-label">{{label}}</label>
                    {{formInput field classes="input-group-field" value=value disabled=@root.isPlayMode}}
                </div>
                {{/each}}
            </div>
            <div class="list-header">
                <div class="hr-text">Abilities
                    <a class="icon fa-solid fa-add" data-action="createAbility"
                        data-tooltip="{{localize 'DOCUMENT.New' type='Ability' }}">
                    </a>
                </div>
            </div>
            <div class="abilities-list {{ifThen (gte abilities.length 2) "multiple" ""}}">
                {{#each abilities}}
                <div class="ability-accordion">
                    <div class="ability-container">
                        <div class="ability-portrait flex">
                            <div class="drag-line draggable" data-doc-id="{{doc._id}}" data-document-class="Item">
                                <i></i>
                            </div>
                            <div class="img-portrait">
                                <img class="ability-icon" src="{{doc.img}}" alt="{{doc.name}}" />
                            </div>
                            <div class="ability-name" data-tooltip="{{doc.name}}">{{doc.name}}</div>
                            <a class="context-menu ability-menu" data-item-uuid="{{uuid}}">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ability-content">
                        <div class="description-content">{{{enrichDescription}}}</div>
                    </div>
                </div>
                {{/each}}
            </div>
            <div class="list-header">
                <div class="hr-text">Moves <a class="icon fa-solid fa-add" data-action="createMove"
                        data-tooltip="{{localize 'DOCUMENT.New' type='Move' }}"></a></div>

            </div>
            <div class="move-list">
                {{#each moves as |move|}}
                {{#if move}}
                <div class="move-container flex">
                    <div class="move-portrait flex">
                        <div class="drag-line draggable" data-doc-id="{{move._id}}" data-document-class="Item">
                            <i></i>
                        </div>
                        <div class="img-portrait" data-action="useItem" data-item-uuid="{{move.uuid}}"
                            data-tooltip="{{localize 'POKEYMANZ.Item.UseItem' item=move.name}}">
                            <img class="move-icon" src="{{move.img}}" alt="{{move.name}}">
                            <img class="roll-icon" src="icons/svg/d20-black.svg" alt="roll-dice">
                        </div>
                    </div>
                    <div class="move-accordion">
                        <div class="move-header flex">
                            <div class="move-name">
                                {{move.name}}
                            </div>
                            <div class="move-type">
                                <div class="type-badge flex items-center size--medium"
                                    style="--type-color: {{move.moveType.color}}">
                                    <img src="{{move.moveType.img}}" alt="{{move.moveType.id}}">
                                    <span>{{localize
                                        move.moveType.name}}</span>
                                </div>
                            </div>
                            <a class="context-menu move-menu" data-item-uuid="{{move.uuid}}">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </a>
                        </div>
                        <div class="move-content">
                            <div class="description-content">
                                {{{move.enrichDescription}}}
                            </div>
                        </div>
                    </div>
                </div>
                {{/if}}
                {{/each}}
            </div>
        </div>
    </div>
</section>