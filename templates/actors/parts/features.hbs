<section class="tab features {{tab.cssClass}}" data-group="primary" data-tab="features">
    <section class="items-list">
        {{#each feats as |section sid|}}
        <div class="item items-header item-grid">
            <i class="{{section.icon}}"></i>
            <div class="item-name">
                <span>{{section.label}}</span>
            </div>
            <div class="item-data">Subtype</div>
            <div class="item-controls">
                <a class="item-control" data-action="createFeat" data-type="{{sid}}" data-tooltip="{{localize 'DOCUMENT.New' type='Feat'}}">
                    <i class="fas fa-plus"></i>
                </a>
            </div>
        </div>
        <section class="item-list" data-category="{{sid}}">
            {{#each section.items}}
            <div class="item" data-doc-id="{{doc.id}}" data-document-class="Item" data-drag="true">
                <div class="item-header item-grid draggable">
                    <i class="accordion-icon fa-solid fa-caret-down"></i>
                    <div class="item-name">
                        <img class="item-image" src="{{doc.img}}" height="24" width="24" alt="{{doc.name}}" />
                        <span>{{doc.name}}</span>
                    </div>

                    <div class="item-data">{{localize doc.system.subtype.label}}</div>

                    <div class="item-controls">
                        <a class="item-control" data-action="viewDoc"
                            data-tooltip="{{localize 'DOCUMENT.Update' type=doc.name}}">
                            <i class="fas fa-edit"></i>
                        </a>

                        {{#if @root.editable}}
                        <a class="item-control" data-action="deleteDoc"
                            data-tooltip="{{localize 'DOCUMENT.Delete' type=doc.name}}">
                            <i class="fas fa-trash"></i>
                        </a>
                        {{/if}}
                    </div>
                </div>
                <div class="item-description">
                    {{{description}}}
                </div>
            </div>
            {{/each}}
        </section>
        {{/each}}
    </section>
</section>